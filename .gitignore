# ─────────────────────────────────────────────────────────────────────────────
#  MRCC CanSat dashboard
#
#  Tracked deliberately, despite looking like tooling:
#    .claude/settings.json      the project's PreToolUse guard hook config
#    .claude/hooks/             the guard script itself
#  Both are project rules, not personal preferences, so the whole team gets them.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Claude Code ------------------------------------------------------------
# Personal, machine-specific. Never shared.
.claude/settings.local.json

# ---- Python -----------------------------------------------------------------
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- Node / frontend --------------------------------------------------------
node_modules/
.vite/

# TypeScript incremental build cache. Regenerated by every `tsc -b`, so it shows up as a
# modification on any branch anyone builds on. Currently still tracked — untrack it with
# `git rm --cached frontend/tsconfig.tsbuildinfo` for this rule to take effect.
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output. Regenerated by `npm run build`, and the filenames are content-hashed,
# so committing it accumulates a new copy of every asset in history on every build.
#
# NOTE (ISS-12): the field laptop has no internet, so the bundle MUST be built before
# leaving for the launch site. That belongs on the pre-launch checklist, not in git —
# if a network-free clone-and-run is wanted, ship a release archive instead.
frontend/dist/

# ---- Flight data ------------------------------------------------------------
# Raw logs and the parsed store, written per run. Generated data that accumulates:
# a 30-minute flight is ~1800 lines, and the raw log is the per-run evidence rather
# than a project artefact. The originals stay on the machine that recorded them.
logs/
*.sqlite
*.sqlite3
*.db

# ---- Environment ------------------------------------------------------------
.env
.env.*
!.env.example

# ---- Editors ----------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---- OS ---------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
