  {"name": "git status",           "expect": "allow", "tool": "Bash",       "command": "git status --short"},
  {"name": "git log",              "expect": "allow", "tool": "Bash",       "command": "git log --oneline -5"},
  {"name": "git -C diff",          "expect": "allow", "tool": "Bash",       "command": "git -C D:/repo diff HEAD"},
  {"name": "git branch -a",        "expect": "allow", "tool": "Bash",       "command": "git branch -a"},
  {"name": "git check-ignore",     "expect": "allow", "tool": "Bash",       "command": "git check-ignore --no-index src/x.ts"},
  {"name": "npm build",            "expect": "allow", "tool": "Bash",       "command": "npm run build"},

