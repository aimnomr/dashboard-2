  {"name": "git add",              "expect": "BLOCK", "tool": "Bash",       "command": "git add ."},
  {"name": "git branch -D",        "expect": "BLOCK", "tool": "Bash",       "command": "git branch -D feature"},
  {"name": "git reset --hard",     "expect": "BLOCK", "tool": "Bash",       "command": "git reset --hard HEAD"},
  {"name": "git checkout",         "expect": "BLOCK", "tool": "Bash",       "command": "git checkout main"},

  {"name": "delete posix",         "expect": "BLOCK", "tool": "Bash",       "command": "\u0072m -rf build/"},
